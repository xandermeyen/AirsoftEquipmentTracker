@page "/"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Linq
@using System.Globalization
@using AirsoftEquipmentTracker.Models
@inject AirsoftEquipmentTracker.Services.EquipmentService EquipmentService
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Overview of your airsoft equipment and recent additions.</p>
    </div>

    <button class="btn btn-dark" @onclick="GoToEquipment">
        View Equipment
    </button>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <p class="eyebrow mb-2">Owned Items</p>
                <p class="stat-value mb-0">@stats.OwnedCount</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <p class="eyebrow mb-2">Total Value (Owned)</p>
                <p class="stat-value accent mb-0">€ @stats.OwnedValue.ToString("0.00")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <p class="eyebrow mb-2">Wishlist Value</p>
                <p class="stat-value mb-0">€ @stats.WishlistValue.ToString("0.00")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <p class="eyebrow mb-2">Categories Used</p>
                <p class="stat-value mb-0">@stats.CategoriesUsed</p>
            </div>
        </div>
    </div>
</div>

<div class="mb-5">
    <h3 class="mb-3">Category Breakdown</h3>

    <div class="row g-4">
        @foreach (var category in stats.CategoryBreakdown)
        {
            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <p class="eyebrow mb-2">@category.Name</p>
                        <p class="stat-value mb-0">@category.Count</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div>
    <h3 class="mb-3">Recent Items</h3>

    @if (stats.RecentItems.Any())
    {
        <div class="row g-4">
            @foreach (var item in stats.RecentItems)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@item.Name</h5>
                                <span class="badge text-bg-dark">@item.Category?.Name</span>
                            </div>

                            <p class="card-text mb-1">
                                <strong>Brand:</strong> @item.Brand?.Name
                            </p>

                            <p class="card-text mb-1">
                                <strong>Price:</strong> € @item.Price.ToString("0.00")
                            </p>

                            <p class="card-text mb-2">
                                <strong>Purchased:</strong>
                                @item.PurchaseDate.ToString("d", CultureInfo.GetCultureInfo("nl-BE"))
                            </p>

                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <p class="card-text text-muted mb-0">@item.Notes</p>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No recent equipment found.
        </div>
    }
</div>

@code {

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Alle berekeningen gebeuren in EquipmentService.GetDashboardStatsAsync
    private DashboardStats stats = DashboardStats.Empty;

    protected override async Task OnInitializedAsync()
    {
        string? userId = null;
        if (AuthState is not null)
        {
            var state = await AuthState;
            userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        if (userId is not null)
            stats = await EquipmentService.GetDashboardStatsAsync(userId);
    }

    private void GoToEquipment()
    {
        Navigation.NavigateTo("/equipment");
    }
}
