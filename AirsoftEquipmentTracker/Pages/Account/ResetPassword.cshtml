@page
@model AirsoftEquipmentTracker.Pages.Account.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Choose a new password · Airsoft Tracker</title>
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body class="auth-body">

<div class="auth-centered">
    <div class="auth-card">
        <div class="brand" style="margin-bottom: 4px;">
            <span class="brand-square"></span>
            Airsoft Tracker
        </div>

        @if (Model.ResetDone)
        {
            <p class="form-eyebrow" style="margin-top: 24px;">All set</p>
            <h2 class="form-heading">Password changed</h2>
            <p style="font-size:14px; color:#555; line-height:1.6; margin-bottom:24px;">
                Your password has been updated. You can sign in with your new password now.
            </p>
            <a class="btn-olive" href="/Account/Login" style="display:block; text-align:center; text-decoration:none;">Sign in</a>
        }
        else
        {
            <p class="form-eyebrow" style="margin-top: 24px;">Reset access</p>
            <h2 class="form-heading">Choose a new password</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="Input.Token" />
                <input type="hidden" asp-for="Input.Email" />

                <div class="field-group">
                    <label class="field-label" for="password">New password</label>
                    <input class="auth-input" type="password" id="password" asp-for="Input.Password"
                           placeholder="At least 8 characters" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label class="field-label" for="confirm">Confirm new password</label>
                    <input class="auth-input" type="password" id="confirm" asp-for="Input.ConfirmPassword"
                           placeholder="Repeat your password" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn-olive">Save new password</button>
            </form>

            <a class="back-link" href="/Account/Login">← Back to sign in</a>
        }
    </div>
</div>

</body>
</html>
